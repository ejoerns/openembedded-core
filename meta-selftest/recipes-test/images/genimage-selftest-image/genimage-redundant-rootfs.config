image ${GENIMAGE_IMAGE_FULLNAME} {
    hdimage {
        align = 1M
        partition-table-type = gpt
    }

    partition root-A {
        image = "core-image-minimal${IMAGE_MACHINE_SUFFIX}.rootfs.ext4"
        size = 256M
        partition-type-uuid = "root-arm"
    }

    partition root-B {
        size = 256M
        partition-type-uuid = "root-arm"
    }

    partition data {
        size = 64M
        partition-type-uuid = "srv"
    }
}
